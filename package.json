{
  "name": "clasptek-prep-portal-v2",
  "version": "1.0.0",
  "private": true,
  "description": "Clasptek Prep Portal V2 Platform Monorepo",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "bootstrap": "node ./scripts/bootstrap.js",
    "verify": "node ./scripts/verify.js",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:e2e": "turbo run test:e2e",
    "sync:auth-users": "tsx ./scripts/sync-auth-users.ts",
    "seed:admin": "tsx ./scripts/seed-admin.ts",
    "report:fitness": "tsx ./scripts/generate-fitness-report.ts",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@supabase/supabase-js": "^2.47.10",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^2.1.8",
    "dependency-cruiser": "^16.5.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.16.0",
    "pg": "^8.13.1",
    "prettier": "^3.4.2",
    "simple-git-hooks": "^2.11.1",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm format:check && pnpm lint",
    "pre-push": "pnpm typecheck && pnpm test"
  }
}
