# Clasptek V2 Monorepo Environmental Settings Template
# Copy this file to .env locally and supply correct database values.

# Port to bind applications
PORT=3000
NODE_ENV=development
CONFIG_VERSION=v1.2.0-local

# Transactional Database connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clasptek_prep

# Supabase deployment configuration settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Administrative server-only authentication keys
SUPABASE_SERVICE_ROLE_KEY=your-supabase-super-admin-service-role-key
# AI Evaluation Infrastructure Settings
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-pro
GEMINI_TIMEOUT=30000

# Active AI grading provider for IELTS subjective evaluation (gemini | openai | mock)
AI_GRADING_PROVIDER=gemini

# Optional Rollback Provider Settings
OPENAI_API_KEY=your-openai-api-key
OPENAI_IELTS_GRADING_MODEL=gpt-4o
OPENAI_TIMEOUT=60000
OPENAI_WHISPER_MODEL=whisper-1
