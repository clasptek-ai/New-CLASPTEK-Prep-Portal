# Clasptek V2 Monorepo Environmental Settings Template
# Copy this file to .env locally and supply correct database values.

# Port to bind applications
PORT=3000
NODE_ENV=development
CONFIG_VERSION=v1.2.0-local

# Transactional Database connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clasptek_prep

# Supabase deployment configuration settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Administrative server-only authentication keys
SUPABASE_SERVICE_ROLE_KEY=your-supabase-super-admin-service-role-key

